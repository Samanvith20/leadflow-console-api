APP_NAME=Leadflow API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://leadflow:leadflow_dev_password@localhost:5432/leadflow
SESSION_COOKIE_NAME=leadflow_session
# Keep false locally over HTTP. Set true in production HTTPS; the API rejects insecure production settings.
SESSION_COOKIE_SECURE=false
PASSWORD_RESET_LIFETIME_MINUTES=30
EMAIL_VERIFICATION_LIFETIME_HOURS=24
FRONTEND_BASE_URL=http://localhost:3000
# Set both values before deploying production. Development logs auth-link URLs instead of sending email.
RESEND_API_KEY=
EMAIL_FROM=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_ENCRYPTION_KEY=
